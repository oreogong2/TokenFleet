# TokenFleet production environment inventory.
#
# This tracked file is safe only while every sensitive or deployment-specific
# value remains a clearly invalid placeholder. Copy it to the ignored
# `server/.env`, replace every <UNSET> value outside version control, and inject
# secrets with the deployment platform's secret manager. TokenFleet does not
# automatically load .env files.

ENVIRONMENT='production'

# Required production values. These placeholders are deliberately unusable.
DATABASE_URL='<UNSET>'
WEB_ROOT='<UNSET>'
JWT_SECRET='<UNSET>'
PUBLIC_ORG_SLUG='<UNSET>'

# JWT identity and lifetime (not secrets).
JWT_ISSUER='tokenfleet'
JWT_AUDIENCE='tokenfleet-api'
JWT_TTL_SECONDS=3600

# Process-local administrator-login limits. Multi-worker production still
# requires a verified shared limiter at the gateway or another shared service.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_IP_ATTEMPTS=50
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_KEYS=10000

# Reverse-proxy trust must be configured explicitly in production. Keep these
# placeholders invalid until the exact proxy CIDRs and hop count are known.
TRUSTED_PROXY_CIDRS='<UNSET>'
TRUSTED_PROXY_HOPS='<UNSET>'

# Process-local anonymous community-read limits and exact-query scan budget.
PUBLIC_RATE_LIMIT_ATTEMPTS=30
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX_KEYS=10000
PUBLIC_MAX_SCAN_ROWS=250000
PUBLIC_CACHE_TTL_SECONDS=15
PUBLIC_CACHE_MAX_ENTRIES=1024

# Process-local anonymous invitation-claim limit. Schema-valid claim requests
# consume this independent bucket before the batch token is queried; multi-worker
# deployments require a verified shared gateway or service-level limiter.
CLAIM_RATE_LIMIT_ATTEMPTS=10
CLAIM_RATE_LIMIT_WINDOW_SECONDS=60
CLAIM_RATE_LIMIT_MAX_KEYS=10000

# Process-local anonymous device-enrollment limit. The reverse proxy also
# applies its own enrollment rate limit; multi-worker deployments require a
# verified shared gateway or service-level limiter.
ENROLLMENT_RATE_LIMIT_ATTEMPTS=60
ENROLLMENT_RATE_LIMIT_WINDOW_SECONDS=60
ENROLLMENT_RATE_LIMIT_MAX_KEYS=10000

# Database-shared device upload limits and retained-row quotas.
USAGE_RATE_LIMIT_DEVICE_ATTEMPTS=12
USAGE_RATE_LIMIT_ORG_ATTEMPTS=600
USAGE_RATE_LIMIT_WINDOW_SECONDS=60
USAGE_MAX_ROWS_PER_DEVICE=100000
USAGE_MAX_ROWS_PER_ORG=2000000

# NONCE_RETENTION_SECONDS must cover at least twice the HMAC clock-skew window
# and the usage rate-limit window.
HMAC_MAX_CLOCK_SKEW_SECONDS=300
NONCE_RETENTION_SECONDS=600

# Human administrator password hashing work factor.
PBKDF2_ITERATIONS=600000

# BOOTSTRAP_ADMIN_PASSWORD is intentionally absent. Supply it only to the one
# create-admin process when unavoidable, then unset it; never persist it here.
