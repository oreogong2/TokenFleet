# TokenFleet first-certificate bootstrap for a shared Nginx host.
# It serves only ACME HTTP-01 challenges and never proxies the application.

server {
    listen 80;
    listen [::]:80;
    server_name __TOKENFLEET_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
