# Direct TLS topology: public client -> host Nginx -> TokenFleet loopback port.
# Existing unrelated virtual hosts are intentionally outside this file.

limit_req_zone $binary_remote_addr zone=tokenfleet_public_ip:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=tokenfleet_login_ip:10m rate=10r/m;
limit_req_status 429;

server {
    listen 80;
    listen [::]:80;
    server_name __TOKENFLEET_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://__TOKENFLEET_DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __TOKENFLEET_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__TOKENFLEET_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__TOKENFLEET_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;

    location = /api/v1/auth/token {
        limit_req zone=tokenfleet_login_ip burst=5 nodelay;
        proxy_pass http://127.0.0.1:__TOKENFLEET_APP_PORT__;
        include /etc/nginx/snippets/tokenfleet-proxy-headers.conf;
    }

    location ^~ /api/v1/public/ {
        limit_req zone=tokenfleet_public_ip burst=10 nodelay;
        proxy_pass http://127.0.0.1:__TOKENFLEET_APP_PORT__;
        include /etc/nginx/snippets/tokenfleet-proxy-headers.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:__TOKENFLEET_APP_PORT__;
        include /etc/nginx/snippets/tokenfleet-proxy-headers.conf;
    }
}
